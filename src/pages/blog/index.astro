---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))];
---

<BaseLayout title="Blog — Web de Finanzas" description="Todos los artículos sobre finanzas personales e inversión.">
  <h1 class="text-3xl font-bold mb-8">Blog</h1>

  {allTags.length > 0 && (
    <div class="flex gap-2 mb-6 flex-wrap">
      <span class="text-sm text-muted">Filtrar:</span>
      {allTags.map((tag) => (
        <span class="bg-gray-100 text-muted text-xs px-3 py-1 rounded-full">{tag}</span>
      ))}
    </div>
  )}

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
      <a href={`/blog/${post.id}`} class="block border rounded-lg p-6 hover:shadow-lg transition-shadow">
        <h2 class="font-bold text-lg">{post.data.title}</h2>
        <p class="text-muted text-sm mt-2">{post.data.description}</p>
        <time class="text-xs text-muted mt-2 block">{post.data.pubDate.toLocaleDateString('es-ES')}</time>
      </a>
    ))}
  </div>
</BaseLayout>
