---
const menu = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
];
---

<header class="bg-dark text-white py-4">
  <nav class="max-w-5xl mx-auto px-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight">Finance<span class="text-accent">+</span></a>
    <ul class="flex gap-6">
      {menu.map((item) => (
        <li>
          <a href={item.href} class="hover:text-accent transition-colors">{item.name}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
