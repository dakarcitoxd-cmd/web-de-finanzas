---
import BaseLayout from './BaseLayout.astro';
import AdSense from '../components/AdSense.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="prose prose-lg max-w-none">
    <header class="mb-8 not-prose">
      <h1 class="text-4xl font-bold text-dark">{frontmatter.title}</h1>
      <p class="text-muted mt-2">{frontmatter.description}</p>
      <time datetime={frontmatter.pubDate.toISOString()} class="text-sm text-muted">
        {frontmatter.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {frontmatter.tags && (
        <div class="flex gap-2 mt-3">
          {frontmatter.tags.map((tag) => (
            <span class="bg-gray-100 text-muted text-xs px-3 py-1 rounded-full">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <AdSense slot="1234567890" />

    <slot />
  </article>
</BaseLayout>
